{
  "info": {
    "name": "AutoAssist IA - B2B API",
    "description": "Diagnóstico automotivo por foto via API. Autenticação: header X-API-Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.autoassist.com.br" },
    { "key": "apiKey", "value": "SUA_CHAVE_AQUI" }
  ],
  "item": [
    {
      "name": "Diagnóstico por foto (JSON)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/b2b/diagnosis?formato=json",
          "host": ["{{baseUrl}}"],
          "path": ["api", "b2b", "diagnosis"],
          "query": [{ "key": "formato", "value": "json" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image\": \"data:image/jpeg;base64,iVBORw0KGgo...\",\n  \"pergunta\": \"Qual o problema indicado pela foto?\"\n}"
        }
      }
    },
    {
      "name": "Diagnóstico por foto (PDF)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/b2b/diagnosis?formato=pdf",
          "host": ["{{baseUrl}}"],
          "path": ["api", "b2b", "diagnosis"],
          "query": [{ "key": "formato", "value": "pdf" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image\": \"data:image/jpeg;base64,iVBORw0KGgo...\"\n}"
        }
      }
    },
    {
      "name": "Consumo da cota (usage)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/b2b/usage",
          "host": ["{{baseUrl}}"],
          "path": ["api", "b2b", "usage"]
        }
      }
    },
    {
      "name": "Criar chave (trial)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{seuJWT}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/b2b/self-serve/keys",
          "host": ["{{baseUrl}}"],
          "path": ["api", "b2b", "self-serve", "keys"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Minha Integracao\",\n  \"plan\": \"trial\"\n}"
        }
      }
    }
  ]
}
